{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!worker-configuration.d.ts",
      "!!bun.lock",
      "!!e2e/artifacts",
      "!!.wrangler",
      "!!node_modules",
      "!public/index.html",
      "!!docs",
      "!!CLAUDE.md",
      "!!CODE_OF_CONDUCT.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
